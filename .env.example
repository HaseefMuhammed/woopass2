# WOO PASS — Environment Configuration Template (.env.example)
# Production secrets and configuration parameters
# NOTE: Never commit real production secrets to version control.

# Firebase Web App Credentials
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA v3 or Enterprise Site Key in Production)
FIREBASE_APPCHECK_KEY=

# Application Security Settings
SESSION_TIMEOUT_MINUTES=5
SESSION_WARNING_SECONDS=270
MAX_FAILED_ATTEMPTS=5
LOCKOUT_SECONDS=30
